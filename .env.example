# Use Clerk development keys locally. Production keys belong in Vercel only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server only. Use separate development services for local work.
APP_ORIGIN=https://vandefi.live
DATABASE_URL=
CLERK_OIDC_ISSUER=https://clerk.vandefi.live
CLERK_OAUTH_CLIENT_ID=
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Dedicated non-root Turnkey service user. A root key is rejected by the code.
TURNKEY_SERVICE_USER_ID=
WALLET_ACTIVATION_ENABLED=false

# Never expose these through NEXT_PUBLIC_*.
ALCHEMY_API_KEY=
LIFI_API_KEY=
# Publishable widget key and separate server-side URL signing secret.
ONRAMPER_API_KEY=
ONRAMPER_SIGNING_SECRET=

# Command center: disabled by default; never enable on a production deployment.
# Preview DATABASE_URL must use its dedicated limited role and isolated Neon branch.
ADMIN_ENABLED=false
ADMIN_ENVIRONMENT=
ADMIN_NEON_BRANCH_ID=
ADMIN_DATABASE_HOST=
ADMIN_PREVIEW_ISOLATED=false
ADMIN_BUILD_AT=
